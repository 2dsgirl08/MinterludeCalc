<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MinterludeCalc.Console</AssemblyName>
    <RootNamespace>MinterludeCalc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinterludeCalc.Core\MinterludeCalc.Core.csproj" />
  </ItemGroup>

  <!-- The standalone msd builds live once at the solution root, under
       Tools/win-x64/msd.exe and Tools/linux-x64/msd, and are copied next to
       whichever app is built, preserving that per-platform subfolder so
       MinaCalc.DefaultToolPath() finds the right one at runtime. Matches
       nothing (rather than failing) if a build hasn't been dropped in yet. -->
  <ItemGroup>
    <None Include="..\Tools\**\*" Link="Tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
