<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MinterludeCalc.Overlay</AssemblyName>
    <RootNamespace>MinterludeCalc.Overlay</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <!-- Only needed for the XAML previewer / dev tools; harmless in release builds -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinterludeCalc.Core\MinterludeCalc.Core.csproj" />
  </ItemGroup>

  <!-- The standalone msd builds live once at the solution root, under
       Tools/win-x64/msd.exe and Tools/linux-x64/msd, and are copied next to
       whichever app is built, preserving that per-platform subfolder so
       MinaCalc.DefaultToolPath() finds the right one at runtime. Matches
       nothing (rather than failing) if a build hasn't been dropped in yet. -->
  <ItemGroup>
    <None Include="..\Tools\**\*" Link="Tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
